<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- TREE VIEW -->
    <record id="videogames_cases_nelson_view_tree" model="ir.ui.view">
        <field name="name">videogames_cases_nelson.view.tree</field>
        <field name="model">videogames.cases.nelson</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" string="Cases">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="release_date" optional="show" />
                <field name="user_id" optional="hide" />
                <field name="status" />
            </tree>
        </field>
    </record>
    <!-- FORM VIEW -->
    <record id="videogames_cases_nelson_view_form" model="ir.ui.view">
        <field name="name">videogames_cases_nelson.view.form</field>
        <field name="model">videogames.cases.nelson</field>
        <field name="arch" type="xml">
            <form string="Cases">
                <header>

                    <field
                        name="status"
                        options="{'clickable':1}"
                        widget="statusbar"
                        statusbar_visible="not_played,in_progress,completed"
                    />
                    <!-- BUTTONS TO CHANGE THE CASE STATUS -->
                    <button
                        string="Not played"
                        name="action_not_played"
                        type="object"
                        class="btn-danger"
                    />
                    <button
                        string="In progress"
                        name="action_in_progress"
                        type="object"
                        class="btn-warning"
                    />
                    <button
                        string="Completed"
                        name="action_completed"
                        type="object"
                        class="btn-success"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Case name" />
                        </h1>
                    </div>
                    <group>
                        <!-- LEFT COLUMN -->
                        <group>
                            <field name="user_id" />
                            <field name="developer" />
                            <field name="description" />
                        </group>
                        <!-- RIGHT COLUMN -->
                        <group>
                            <field name="release_date" />
                            <field name="multiplayer" />
                            <field name="publisher" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
