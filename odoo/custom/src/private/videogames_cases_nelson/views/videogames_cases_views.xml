<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="videogames_cases_nelson_view_tree" model="ir.ui.view">
        <field name="name">videogames_cases_nelson.view.tree</field>
        <field name="model">videogames.cases.nelson</field>
        <field name="arch" type="xml">
            <tree string="Cases">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="release_date" optional="show" />
                <field name="user_id" optional="hide" />
                <field name="status" />
            </tree>
        </field>
    </record>

    <record id="videogames_cases_nelson_view_form" model="ir.ui.view">
        <field name="name">videogames_cases_nelson.view.form</field>
        <field name="model">videogames.cases.nelson</field>
        <field name="arch" type="xml">
            <form string="Cases">
                <header>
                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="not_played,in_progress,completed"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Case name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="developer" />
                            <field name="description" />
                        </group>

                        <group>
                            <field name="release_date" />
                            <field name="multiplayer" />
                            <field name="publisher" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
