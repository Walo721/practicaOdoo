<odoo>

<record id="ir_module_videogames_cases_nelson" model="ir.module.category">
    <field name="name">Videogames Cases Nelson</field>
</record>

<!-- GROUPS -->
<record id="res_groups_videogames_user" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="ir_module_videogames_cases_nelson" />
    <field name="comment">
        The user will be able to browse some model.
    </field>
</record>

<record id="res_groups_videogames_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="category_id" ref="ir_module_videogames_cases_nelson" />
    <field name="implied_ids" eval="[(4, ref('res_groups_videogames_user'))]" />
    <field name="comment">
        The user will be able to manage some model.
    </field>
    <field name="users" eval="[(4, ref('base.user_admin'))]" />
</record>

<!-- RULES -->

  <record id="videogames_cases_nelson_personal_rule" model="ir.rule">
        <field name="name">Personal Games</field>
        <field ref="model_videogames_cases_nelson" name="model_id" />
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('res_groups_videogames_user'))]" />
    </record>

    <record id="videogames_cases_nelson_see_all" model="ir.rule">
        <field name="name">All Games</field>
        <field ref="model_videogames_cases_nelson" name="model_id" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('res_groups_videogames_manager'))]" />
    </record>

</odoo>
